# Hosted Supabase project (Project Settings -> Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Client-visible by design; every table is RLS
# protected with a select-only policy, so it cannot write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Seeding only. Never referenced by the application, never prefixed
# NEXT_PUBLIC_, and never committed. Leave unset in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
